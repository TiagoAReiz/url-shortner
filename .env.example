# Variáveis lidas pelo docker-compose.yaml (copie para .env na raiz).

# Client ID OAuth 2.0 (tipo "Aplicativo da Web") do Google Cloud.
# Origens JavaScript autorizadas no Google: http://localhost:5173 e http://localhost
GOOGLE_CLIENT_ID=

# Segredo que assina o JWT da sessão. Gere um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# E-mails (separados por vírgula) com acesso à visão de admin.
ADMIN_EMAILS=

# Origem(ns) do frontend liberadas no CORS (separadas por vírgula).
CORS_ORIGIN=http://localhost:5173

# URL da API vista pelo navegador (o nginx, porta 80).
NEXT_PUBLIC_API_URL=http://localhost

# Porta do frontend no seu computador (a 3000 costuma estar ocupada por outros projetos; 5173 é a origem cadastrada no Google).
FRONTEND_PORT=5173
