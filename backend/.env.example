# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public base URL of this app, used to build the returned short link.
APP_URL="http://localhost:3001"
PORT=3001

# RabbitMQ (publisher de eventos de acesso)
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://user:example@localhost:5672"
