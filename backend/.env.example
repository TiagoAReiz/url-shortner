# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public base URL of this app, used to build the returned short link.
APP_URL="http://localhost:3001"
PORT=3001

# RabbitMQ (publisher de eventos de acesso)
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://user:example@localhost:5672"

# --- Auth (Google SSO) ---
# Client ID OAuth 2.0 (tipo "Web") criado em console.cloud.google.com > APIs e serviços > Credenciais.
GOOGLE_CLIENT_ID=""
# Segredo para assinar o JWT da sessão. Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
# E-mails (separados por vírgula) com acesso à visão de admin.
ADMIN_EMAILS="voce@gmail.com"
# Origem(ns) do frontend liberadas no CORS (separadas por vírgula).
CORS_ORIGIN="http://localhost:5173"
